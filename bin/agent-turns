#!/usr/bin/env bash
set -euo pipefail

# agent-turns v2.3.0 - token-efficient consensus loop with symmetric provider fallback
#
# Env vars:
#   AGENT_BRIDGE_HOME            base dir for runs (default: ~/agent-bridge)
#   AGENT_BRIDGE_TIMEOUT         seconds per agent turn (default: 900)
#   AGENT_BRIDGE_VERIFY_CMD      ground-truth command run after a turn that changed files
#   AGENT_BRIDGE_VERIFY_TIMEOUT  seconds for verify cmd (default: 300)
#   AGENT_BRIDGE_HISTORY_TURNS   sections kept in handoff (default: 2; 4 if VERIFY_CMD set)
#   AGENT_BRIDGE_RESUME          1 = resume Claude session across rounds (default: 1, needs jq)
#   AGENT_BRIDGE_CODEX_RESUME    1 = codex exec resume --last (default: 0, needs recent codex CLI)
#   AGENT_BRIDGE_MAX_FALLBACK_CHARS  chars kept when output has no STATUS block (default: 1200)
#   AGENT_BRIDGE_FALLBACKS        comma-separated fallback providers (default: opencode,agy)
#   AGENT_BRIDGE_OPENCODE_MODEL   OpenCode model (default: opencode-go/minimax-m3); inline: [opencode:model]
#   AGENT_BRIDGE_ANTIGRAVITY_MODEL  agy model (default: Gemini 3.5 Flash (Medium)); inline: [agy:model]

usage() { echo "Usage: agent-turns <workspace> <goal> [rounds]" >&2; }

[[ $# -ge 2 ]] || { usage; exit 2; }

workspace="$1"
goal="$2"
rounds="${3:-2}"

[[ -d "$workspace" ]] || { echo "Workspace not found: $workspace" >&2; exit 2; }
[[ "$rounds" =~ ^[0-9]+$ && "$rounds" -ge 1 ]] || { echo "Rounds must be a positive integer" >&2; exit 2; }

# ── Gate 14B.2: política fail-closed de workspaces autorizados ────────────────
# Compatibilidad CLI: únicamente sin política configurada permite cualquier
# directorio (con advertencia). Una política declarada pero vacía, inaccesible
# o inexistente NUNCA desactiva el control. Hermes debe fijar REQUIRE_ALLOWLIST=1.
canon_path() {
  local p="$1"
  if command -v python3 >/dev/null 2>&1; then
    python3 -c 'import os,sys; print(os.path.realpath(sys.argv[1]))' "$p" 2>/dev/null && return 0
  fi
  if command -v realpath >/dev/null 2>&1; then realpath "$p" 2>/dev/null && return 0; fi
  readlink -f "$p" 2>/dev/null
}
_g14b_reject_workspace() {
  echo "Workspace not authorized (${1:-allowlist policy}): $workspace" >&2
  exit 7
}
_g14b_allow_file="${AGENT_BRIDGE_ALLOWLIST_FILE-$HOME/.agent-bridge/authorized-workspaces}"
_g14b_allow_spec=""
_g14b_policy_active=0
case "${AGENT_BRIDGE_REQUIRE_ALLOWLIST:-0}" in
  0|1) ;;
  *) _g14b_reject_workspace "invalid AGENT_BRIDGE_REQUIRE_ALLOWLIST value" ;;
esac
if [[ ${AGENT_BRIDGE_ALLOWED_WORKSPACES+x} ]]; then
  # La variable tiene precedencia sobre el archivo, incluso si está vacía.
  _g14b_policy_active=1
  _g14b_allow_spec="$AGENT_BRIDGE_ALLOWED_WORKSPACES"
elif [[ ${AGENT_BRIDGE_ALLOWLIST_FILE+x} || -e "$_g14b_allow_file" || -L "$_g14b_allow_file" ]]; then
  _g14b_policy_active=1
  [[ -n "$_g14b_allow_file" && -f "$_g14b_allow_file" && -r "$_g14b_allow_file" ]] ||
    _g14b_reject_workspace "allowlist file missing or unreadable"
  _g14b_allow_spec="$(sed -e '/^[[:space:]]*#/d' -e '/^[[:space:]]*$/d' "$_g14b_allow_file" | tr '\n' ':')" ||
    _g14b_reject_workspace "cannot read allowlist file"
fi
if [[ "$_g14b_policy_active" -eq 1 ]]; then
  _g14b_allow_spec="${_g14b_allow_spec//$'\n'/:}"
  [[ -n "$_g14b_allow_spec" ]] || _g14b_reject_workspace "allowlist contains no workspaces"
  _g14b_ws_canon="$(canon_path "$workspace")"
  [[ -n "$_g14b_ws_canon" ]] || _g14b_reject_workspace
  _g14b_ws_authed=0
  IFS=$':' read -r -a _g14b_entries <<< "$_g14b_allow_spec"
  for _g14b_entry in "${_g14b_entries[@]}"; do
    [[ -n "$_g14b_entry" ]] || continue
    _g14b_entry_canon="$(canon_path "${_g14b_entry%/}")"
    [[ -n "$_g14b_entry_canon" && "$_g14b_entry_canon" == "$_g14b_ws_canon" ]] &&
      { _g14b_ws_authed=1; break; }
  done
  [[ "$_g14b_ws_authed" -eq 1 ]] || _g14b_reject_workspace
  echo "  workspace authorized (canonical): $_g14b_ws_canon" >&2
elif [[ "${AGENT_BRIDGE_REQUIRE_ALLOWLIST:-0}" == 1 ]]; then
  _g14b_reject_workspace "allowlist required but not configured"
else
  echo "WARNING: no allowlist configured; any existing directory is accepted. Hermes must set AGENT_BRIDGE_REQUIRE_ALLOWLIST=1." >&2
fi
unset _g14b_allow_spec _g14b_allow_file _g14b_policy_active _g14b_ws_authed _g14b_entry _g14b_entry_canon

# # Parse inline model directives from goal: [opencode:model] [agy:model]
# Only these two lowercase provider names are supported. Provider names are
# case-sensitive; the value must be non-empty, must not contain ']', and must
# not contain a carriage return (CR) — directives are single-line constructs.
# The goal is split into logical lines (LF is the line separator and is
# never treated as part of a directive value) and each line is parsed
# independently, so a directive can never span multiple lines. The first
# valid occurrence per provider, in document order across all lines, selects
# that provider's model; every valid occurrence (for both providers) is
# removed from the goal. Unrelated/invalid bracket text (wrong case, empty
# value, unterminated, or split/embedded CR/LF) is preserved byte-for-byte.
# Only the outer whitespace of the whole goal is trimmed, once, at the end —
# internal blank lines and internal line whitespace are never touched.
_cr=$'\r'
_oc_re="\\[opencode:([^]${_cr}]+)\\]"
_agy_re="\\[agy:([^]${_cr}]+)\\]"
_oc_model=""
_agy_model=""
_cleaned_goal=""
_first_line=1
while IFS= read -r _dir_line || [[ -n "$_dir_line" ]]; do
  _work="$_dir_line"
  while [[ "$_work" =~ $_oc_re ]]; do
    _match="${BASH_REMATCH[0]}"
    [[ -z "$_oc_model" ]] && _oc_model="${BASH_REMATCH[1]}"
    _work="${_work/"$_match"/}"
  done
  while [[ "$_work" =~ $_agy_re ]]; do
    _match="${BASH_REMATCH[0]}"
    [[ -z "$_agy_model" ]] && _agy_model="${BASH_REMATCH[1]}"
    _work="${_work/"$_match"/}"
  done
  if [[ "$_first_line" -eq 1 ]]; then
    _cleaned_goal="$_work"
    _first_line=0
  else
    _cleaned_goal="${_cleaned_goal}"$'\n'"${_work}"
  fi
done < <(printf '%s' "$goal")
[[ -n "$_oc_model" ]] && export AGENT_BRIDGE_OPENCODE_MODEL="$_oc_model"
[[ -n "$_agy_model" ]] && export AGENT_BRIDGE_ANTIGRAVITY_MODEL="$_agy_model"
_extglob_was_set=0
shopt -q extglob && _extglob_was_set=1
shopt -s extglob
goal="${_cleaned_goal##+([[:space:]])}"
goal="${goal%%+([[:space:]])}"
[[ "$_extglob_was_set" -eq 0 ]] && shopt -u extglob
unset _cr _oc_re _agy_re _oc_model _agy_model _cleaned_goal _first_line _dir_line _work _match _extglob_was_set

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
bridge_dir="${AGENT_BRIDGE_HOME:-$HOME/agent-bridge}"
run_id="$(date +%Y%m%d-%H%M%S)-$$"
run_dir="$bridge_dir/runs/$run_id"
turn_timeout="${AGENT_BRIDGE_TIMEOUT:-900}"
verify_cmd="${AGENT_BRIDGE_VERIFY_CMD:-}"
verify_timeout="${AGENT_BRIDGE_VERIFY_TIMEOUT:-300}"
if [[ -n "${AGENT_BRIDGE_HISTORY_TURNS:-}" ]]; then
  history_turns="$AGENT_BRIDGE_HISTORY_TURNS"
elif [[ -n "$verify_cmd" ]]; then
  history_turns=4
else
  history_turns=2
fi
fallback_chars="${AGENT_BRIDGE_MAX_FALLBACK_CHARS:-1200}"
resume_claude="${AGENT_BRIDGE_RESUME:-1}"
resume_codex="${AGENT_BRIDGE_CODEX_RESUME:-0}"
fallbacks="${AGENT_BRIDGE_FALLBACKS:-opencode,agy}"
mkdir -p "$run_dir"

# Session-wide provider failure tracking — any provider that fails is skipped for the rest of the session
_failed_providers=" "
mark_failed() { _failed_providers+="${1} "; echo "  provider unavailable for this session: $1" >&2; }
is_failed()   { [[ "$_failed_providers" == *" ${1} "* ]]; }
# Gate 14B.4.3 (RT-01b): los fallos ocurridos EXCLUSIVAMENTE en el rol árbitro
# se registran en esta lista paralela, sin marcar globalmente al proveedor.
# is_failed_judge() se consulta SOLO en call_judge(), junto al estado global;
# call_fallback() sigue consultando únicamente is_failed(), de modo que un
# proveedor caído solo como árbitro conserva su elegibilidad para
# implementador/revisor, mientras que un caído en un rol global permanece
# inhabilitado también para el árbitro (call_judge comprueba AMBOS estados).
_failed_judge_providers=" "
mark_failed_judge() { _failed_judge_providers+="${1} "; echo "  provider unavailable for arbitration this session: $1" >&2; }
is_failed_judge()   { [[ "$_failed_judge_providers" == *" ${1} "* ]]; }

# ── Gate 14B / P0-3: detección objetiva de cambios en el workspace ───────────
# Hash del estado del workspace: cada archivo/symlink/directorio entra con
# tipo, ruta, tamaño, mtime, destino del enlace y nlink, MÁS los hashes de
# contenido de cada archivo regular (Gate 14B.1: los metadatos solos
# permitían un falso negativo modificando contenido conservando tamaño y
# mtime). Alcance real: archivos nuevos, modificados (contenido o solo
# mtime) y eliminados; symlinks retargeted; archivos ignorados por Git
# incluidos (el toque del agente cuenta). Mtime sin cambio de contenido
# cuenta como cambio: es deliberadamente conservador.
# Fail-closed Gate 14B.1: los hashes se calculan por archivo y se coteja el
# conteo contra el inventario; si algún archivo no se puede leer/hashear
# (o sha256sum no existe), el snapshot se declara UNRELIABLE y la política
# falla cerrada en vez de validar un snapshot aparentemente correcto.
# Límite documentado: -xdev restringe la detección al propio filesystem;
# montajes externos, red y /proc no son observados — en ese caso el
# detector reporta no-confiable (ws_detection_reliable=0) y la política
# falla cerrada.
# ── Gate 14B.3: fail-closed sobre fallos de enumeración ─────────────────────
# find que no puede leer un directorio (p.ej. chmod 000) omite su contenido
# pero termina con rc!=0: una lista aparentemente "completa" no garantiza
# nada. Si la enumeración (lista o hashes) no termina en 0, el snapshot se
# declara UNRELIABLE y la política falla cerrada, nunca valida un snapshot
# simplemente plausible.
ws_snapshot() {
  local list hashes n_files n_hashed rc_list rc_hash
  rc_list=0; rc_hash=0
  list="$( ( cd "$workspace" 2>/dev/null && \
    find . -xdev \( -type d -o -type f -o -type l \) -printf '%y|%p|%s|%T@|%l|%n\n' 2>/dev/null | sort ) 2>/dev/null )" || rc_list=$?
  [[ "$rc_list" -eq 0 ]] || { printf 'UNRELIABLE'; return 0; }
  # El punto de partida '.' siempre aparece si el workspace es legible; una
  # lista vacía = snapshot no garantizable → centinela, y la política falla cerrada.
  [[ -n "$list" ]] || { printf 'UNRELIABLE'; return 0; }
  # Hashes de contenido reales por archivo regular; si alguno falla (ilegible,
  # desaparecido, sha256sum ausente), el conteo difiere y todo el snapshot
  # se declara no confiable.
  hashes="$( ( cd "$workspace" 2>/dev/null && \
    find . -xdev -type f -exec sha256sum {} + 2>/dev/null | sort ) 2>/dev/null )" || rc_hash=$?
  [[ "$rc_hash" -eq 0 ]] || { printf 'UNRELIABLE'; return 0; }
  n_files="$(printf '%s\n' "$list" | grep -c '^f|')"
  n_hashed="$(printf '%s\n' "$hashes" | grep -c '.')"
  if [[ "$n_hashed" -lt "$n_files" ]]; then
    printf 'UNRELIABLE'; return 0
  fi
  printf '%s\n' "$list" "$hashes" | ( if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi ) | awk '{print $1}'
}
ws_snapshot_ok() { local h="$1"; [[ -n "$h" && "$h" != "UNRELIABLE" ]]; }

have_jq=0
command -v jq >/dev/null 2>&1 && have_jq=1
if [[ "$resume_claude" == "1" && "$have_jq" -ne 1 ]]; then
  echo "jq not found: disabling Claude session resume + cost tracking." >&2
  resume_claude=0
fi

if [[ "$resume_codex" == "1" ]]; then
  if ! codex exec resume --help >/dev/null 2>&1; then
    echo "AGENT_BRIDGE_CODEX_RESUME=1, but this codex CLI does not support 'exec resume'." >&2
    echo "Set AGENT_BRIDGE_CODEX_RESUME=0 or upgrade the codex CLI." >&2
    exit 2
  fi
fi

protocol="$run_dir/protocol.md"
cat > "$protocol" <<'EOF'
# Bridge Protocol (compact mode)

Respond with EXACTLY this shape, 12 lines max, no narration:

STATUS: PROPOSED | VERIFIED | DISAGREE | REVISE | BLOCKED | COMPLETE
CHANGED: files or "none"
EVIDENCE: command/result or "not run"
NEXT: one concrete next action or "none"
HANDOFF: one sentence to the next agent

Rules:
- Token rule: output the protocol block only. No preamble, no narration. Omit EVIDENCE if "not run".
- Prefer evidence over explanation. Small, verifiable changes.
- Do not undo the other agent's work unless it is clearly wrong.
- Never mark COMPLETE for your own unverified implementation.
- VERIFIED means you independently checked the other agent's work and it holds.
- If you DISAGREE: one concrete reason + one proposed correction.
EOF

extract_block() {
  local file="$1" block
  block="$(grep -E '^(STATUS|CHANGED|EVIDENCE|NEXT|HANDOFF):' "$file" | head -5 || true)"
  if [[ -n "$block" ]]; then
    printf '%s\n' "$block"
  else
    echo "[no protocol block found; head of raw output]"
    head -c "$fallback_chars" "$file"
    echo
  fi
}

synth_block() {
  cat > "$1" <<EOF
STATUS: BLOCKED
CHANGED: none
EVIDENCE: $2
NEXT: operator intervention required
HANDOFF: orchestrator-generated block; the agent call failed or returned unparseable output
EOF
}

get_field() {
  grep -m1 -E "^$2:" "$1" | sed -E "s/^$2:[[:space:]]*//" || true
}

get_status() {
  get_field "$1" STATUS | tr '[:lower:]' '[:upper:]' | awk '{print $1}'
}

handoff_file="$run_dir/handoff.md"
: > "$handoff_file"

trim_handoff() {
  awk -v keep="$history_turns" '
    /^## / { s++ }
    { lines[NR] = $0; sec[NR] = s }
    END { for (i = 1; i <= NR; i++) if (sec[i] > s - keep) print lines[i] }
  ' "$handoff_file" > "$handoff_file.tmp" && mv "$handoff_file.tmp" "$handoff_file"
}

push_handoff() {
  {
    echo "## $1"
    extract_block "$2"
    echo
  } >> "$handoff_file"
  trim_handoff
}

push_note() {
  printf '## %s\n\n' "$1" >> "$handoff_file"
  trim_handoff
}

round_verify_failed=0

run_verify() {
  local round="$1" agent="$2" log rc
  log="$run_dir/verify-r${round}-${agent}.log"
  set +e
  ( cd "$workspace" && timeout "$verify_timeout" bash -c "$verify_cmd" ) > "$log" 2>&1
  rc=$?
  set -e
  if [[ $rc -eq 0 ]]; then
    round_verify_failed=0
    push_note "GROUND TRUTH after $agent (round $round): \`$verify_cmd\` exit=0 :: $(tail -c 300 "$log" | tr '\n' ' ')"
  else
    round_verify_failed=1
    push_note "GROUND TRUTH FAILED after $agent (round $round): \`$verify_cmd\` exit=$rc - VERIFIED/COMPLETE will be rejected this round :: $(tail -c 300 "$log" | tr '\n' ' ')"
  fi
  echo "  verify: exit=$rc ($log)"
}

build_prompt() {
  local out="$1" role="$2" context_line="${3:-}"
  shift 3
  {
    cat "$protocol"
    echo
    echo "GOAL: $goal"
    echo "WORKSPACE: $workspace"
    echo "YOU ARE: $role"
    [[ -z "$context_line" ]] || echo "$context_line"
    echo
    echo "# Recent turns"
    if [[ -s "$handoff_file" ]]; then cat "$handoff_file"; else echo "(first turn)"; fi
    echo
    echo "# Your turn"
    printf '%s\n' "$@"
  } > "$out"
}

claude_session_id=""
total_cost="0"

# Round-scoped provider-identity tracking (independent-review enforcement).
# Canonical identities: claude, codex, opencode, agy. Aliases (e.g.
# "antigravity") are normalized to their canonical form before any
# comparison. This is keyed strictly on which actual provider produced the
# accepted output for a role — never on role text, filename, PID, response
# content, model self-claims, or call order.
_last_fallback_provider=""
_last_fallback_outcome=""

normalize_provider() {
  local p="${1//[[:space:]]/}"
  [[ "$p" == "antigravity" ]] && p="agy"
  printf '%s' "$p"
}

is_supported_fallback_provider() {
  case "$1" in
    opencode|agy) return 0 ;;
    *) return 1 ;;
  esac
}

# Strict, local, deterministic validation of a normal turn protocol response
# (STATUS/CHANGED/EVIDENCE/NEXT/HANDOFF). This is the single authoritative
# acceptance check for fallback candidates in call_fallback below; wrapper
# scripts (e.g. ask-antigravity) may run their own coarse pre-check to fail
# fast, but only this function decides whether a candidate response is
# accepted into the run. Does NOT parse or touch judge VERDICT: output.
#
# Contract:
#   - STATUS, CHANGED, NEXT, HANDOFF must each appear exactly once, anchored
#     at line start, with a non-empty value after trimming whitespace.
#   - EVIDENCE may appear at most once (optional).
#   - STATUS value must be one of: PROPOSED VERIFIED DISAGREE REVISE BLOCKED COMPLETE.
#   - Every non-blank line in the file must be a recognized protocol field
#     line (single-line values only) — any other line (narration before,
#     between, or after the block) causes rejection. Empty and
#     whitespace-only lines are tolerated since they introduce no
#     ambiguity; leading whitespace/indentation before a protocol key is
#     NOT stripped from the line itself, so an indented key (e.g. "  STATUS:
#     VERIFIED") is still rejected as an unrecognized line.
_valid_status_re='^(PROPOSED|VERIFIED|DISAGREE|REVISE|BLOCKED|COMPLETE)$'

validate_turn_protocol() {
  local file="$1"
  [[ -s "$file" ]] || return 1

  local line status_n=0 changed_n=0 evidence_n=0 next_n=0 handoff_n=0
  local status_v="" changed_v="" next_v="" handoff_v=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line//[[:space:]]/}" ]] && continue
    case "$line" in
      STATUS:*)   status_n=$((status_n + 1));   status_v="${line#STATUS:}" ;;
      CHANGED:*)  changed_n=$((changed_n + 1)); changed_v="${line#CHANGED:}" ;;
      EVIDENCE:*) evidence_n=$((evidence_n + 1)) ;;
      NEXT:*)     next_n=$((next_n + 1));       next_v="${line#NEXT:}" ;;
      HANDOFF:*)  handoff_n=$((handoff_n + 1)); handoff_v="${line#HANDOFF:}" ;;
      *)
        return 1
        ;;
    esac
  done < "$file"

  [[ "$status_n" -eq 1 && "$changed_n" -eq 1 && "$next_n" -eq 1 && "$handoff_n" -eq 1 ]] || return 1
  [[ "$evidence_n" -le 1 ]] || return 1

  status_v="$(printf '%s' "$status_v" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  changed_v="$(printf '%s' "$changed_v" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  next_v="$(printf '%s' "$next_v" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  handoff_v="$(printf '%s' "$handoff_v" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"

  [[ -n "$status_v" && -n "$changed_v" && -n "$next_v" && -n "$handoff_v" ]] || return 1
  [[ "$status_v" =~ $_valid_status_re ]] || return 1

  return 0
}

# Strict, local, deterministic validation of a judge response
# (STATUS/CHANGED/EVIDENCE/NEXT/HANDOFF/VERDICT). This is the single
# authoritative acceptance check for judge candidates (both the primary
# OpenCode judge and the agy fallback judge) in call_judge below. A judge
# response is accepted only when it satisfies the COMPLETE protocol below —
# never merely because a STATUS: or VERDICT: line exists somewhere in the
# text.
#
# Contract (same structural rules as validate_turn_protocol, plus VERDICT):
#   - STATUS, CHANGED, NEXT, HANDOFF, VERDICT must each appear exactly once,
#     anchored at line start, with a non-empty value after trimming
#     whitespace.
#   - EVIDENCE may appear at most once (optional).
#   - STATUS value must be one of: PROPOSED VERIFIED DISAGREE REVISE BLOCKED
#     COMPLETE (same enum as validate_turn_protocol).
#   - VERDICT value must be exactly one of: ACCEPT_CLAUDE ACCEPT_CODEX
#     REQUEST_REVISION BLOCKED (case-sensitive, no extra text on the line).
#   - Every non-blank line in the file must be a recognized protocol field
#     line; any other line (narration, Markdown fences, unknown fields,
#     decoy verdict tokens embedded in another field's value) causes
#     rejection. Empty and whitespace-only lines are tolerated using the
#     exact same blank-line logic as validate_turn_protocol; leading
#     whitespace/indentation before a protocol key is NOT stripped, so an
#     indented key is rejected as an unrecognized line.
#   - A verdict token appearing inside STATUS/CHANGED/EVIDENCE/NEXT/HANDOFF
#     values, or in any unrecognized narration line, never counts as the
#     verdict and never causes acceptance on its own.
_valid_verdict_re='^(ACCEPT_CLAUDE|ACCEPT_CODEX|REQUEST_REVISION|BLOCKED)$'

validate_judge_protocol() {
  local file="$1"
  [[ -s "$file" ]] || return 1

  local line status_n=0 changed_n=0 evidence_n=0 next_n=0 handoff_n=0 verdict_n=0
  local status_v="" changed_v="" next_v="" handoff_v="" verdict_v=""

  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "${line//[[:space:]]/}" ]] && continue
    case "$line" in
      STATUS:*)   status_n=$((status_n + 1));   status_v="${line#STATUS:}" ;;
      CHANGED:*)  changed_n=$((changed_n + 1)); changed_v="${line#CHANGED:}" ;;
      EVIDENCE:*) evidence_n=$((evidence_n + 1)) ;;
      NEXT:*)     next_n=$((next_n + 1));       next_v="${line#NEXT:}" ;;
      HANDOFF:*)  handoff_n=$((handoff_n + 1)); handoff_v="${line#HANDOFF:}" ;;
      VERDICT:*)  verdict_n=$((verdict_n + 1)); verdict_v="${line#VERDICT:}" ;;
      *)
        return 1
        ;;
    esac
  done < "$file"

  [[ "$status_n" -eq 1 && "$changed_n" -eq 1 && "$next_n" -eq 1 && "$handoff_n" -eq 1 && "$verdict_n" -eq 1 ]] || return 1
  [[ "$evidence_n" -le 1 ]] || return 1

  status_v="$(printf '%s' "$status_v" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  changed_v="$(printf '%s' "$changed_v" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  next_v="$(printf '%s' "$next_v" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  handoff_v="$(printf '%s' "$handoff_v" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  verdict_v="$(printf '%s' "$verdict_v" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"

  [[ -n "$status_v" && -n "$changed_v" && -n "$next_v" && -n "$handoff_v" && -n "$verdict_v" ]] || return 1
  [[ "$status_v" =~ $_valid_status_re ]] || return 1
  [[ "$verdict_v" =~ $_valid_verdict_re ]] || return 1

  return 0
}

# Anchored, defense-in-depth verdict extraction. Assumes the input already
# passed validate_judge_protocol, but still reads ONLY the anchored
# `VERDICT: ` field line rather than trusting prior validation blindly or
# searching arbitrary file text for a bare token.
judge_verdict() {
  local f="$1" line
  line="$(grep -m1 -E '^VERDICT:' "$f" || true)"
  [[ -n "$line" ]] || { printf ''; return 0; }
  printf '%s' "${line#VERDICT:}" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//'
}

# Human-readable summary of an already-validated judge response, built ONLY
# from anchored field lines (never a whole-file token search).
judge_summary() {
  local f="$1"
  printf 'VERDICT: %s :: STATUS: %s :: HANDOFF: %s' \
    "$(judge_verdict "$f")" "$(get_field "$f" STATUS)" "$(get_field "$f" HANDOFF)"
}

call_claude() {
  local prompt="$1" out="$2" raw="$2.json" rc result cost
  is_failed claude && return 1
  local -a cmd=(claude -p --permission-mode acceptEdits --add-dir "$workspace")
  if [[ "$resume_claude" == "1" ]]; then
    cmd+=(--output-format json)
    [[ -n "$claude_session_id" ]] && cmd+=(--resume "$claude_session_id")
    set +e
    ( cd "$workspace" && timeout "$turn_timeout" "${cmd[@]}" < "$prompt" > "$raw" )
    rc=$?
    set -e
    if [[ $rc -ne 0 ]]; then
      mark_failed claude
      synth_block "$out" "claude CLI failed (exit=$rc, timeout=${turn_timeout}s); raw output: $raw"
      return 1
    fi
    result="$(jq -r '.result // empty' "$raw" 2>/dev/null || true)"
    if [[ -z "$result" ]]; then
      mark_failed claude
      synth_block "$out" "claude returned unparseable/empty JSON; raw output: $raw"
      return 1
    fi
    printf '%s\n' "$result" > "$out"
    claude_session_id="$(jq -r '.session_id // empty' "$raw" 2>/dev/null || true)"
    cost="$(jq -r '.total_cost_usd // 0' "$raw" 2>/dev/null || echo 0)"
    total_cost="$(awk -v a="$total_cost" -v b="$cost" 'BEGIN{printf "%.4f", a+b}')"
    echo "  claude: \$${cost} (cumulative \$${total_cost})"
  else
    cmd+=(--output-format text)
    set +e
    ( cd "$workspace" && timeout "$turn_timeout" "${cmd[@]}" < "$prompt" > "$out" )
    rc=$?
    set -e
    if [[ $rc -ne 0 ]]; then
      mark_failed claude
      synth_block "$out" "claude CLI failed (exit=$rc, timeout=${turn_timeout}s)"
      return 1
    fi
  fi
}

call_codex() {
  local prompt="$1" out="$2" rc
  is_failed codex && return 1
  local -a cmd=(codex --ask-for-approval never exec --cd "$workspace" --sandbox workspace-write)
  if [[ "$resume_codex" == "1" ]]; then
    cmd=(codex --ask-for-approval never exec resume --last --cd "$workspace" --sandbox workspace-write)
  fi
  set +e
  timeout "$turn_timeout" "${cmd[@]}" --output-last-message "$out" - < "$prompt"
  rc=$?
  set -e
  if [[ $rc -ne 0 || ! -s "$out" ]]; then
    mark_failed codex
    synth_block "$out" "codex CLI failed (exit=$rc, timeout=${turn_timeout}s) or wrote empty output"
    return 1
  fi
}

call_fallback() {
  # $4 (exclude) is the provider identity that already fulfilled a role this
  # round (e.g. the implementer). It must never be selected again as the
  # reviewer for the same round. Exclusion is round-scoped and MUST NOT be
  # recorded via mark_failed: an excluded provider did not fail, and must
  # remain eligible for other rounds/roles where independence is not at risk.
  local role="$1" prompt="$2" out="$3" exclude provider rc candidate
  exclude="$(normalize_provider "${4:-}")"
  local -a providers
  IFS=',' read -r -a providers <<< "$fallbacks"

  _last_fallback_provider=""
  _last_fallback_outcome=""

  local distinct_supported=" " distinct_supported_count=0
  for provider in "${providers[@]}"; do
    provider="$(normalize_provider "$provider")"
    [[ -n "$provider" ]] || continue
    is_supported_fallback_provider "$provider" || continue
    [[ -n "$exclude" && "$provider" == "$exclude" ]] && continue
    if [[ "$distinct_supported" != *" ${provider} "* ]]; then
      distinct_supported+="${provider} "
      distinct_supported_count=$((distinct_supported_count + 1))
    fi
  done

  for provider in "${providers[@]}"; do
    provider="$(normalize_provider "$provider")"
    [[ -n "$provider" ]] || continue
    if is_failed "$provider"; then
      echo "  fallback: skipping $provider (unavailable this session)"
      continue
    fi
    if [[ -n "$exclude" && "$provider" == "$exclude" ]]; then
      echo "  fallback: skipping $provider (already participated this round as a different role; independent review requires a distinct provider identity)"
      continue
    fi
    echo "  fallback: trying $provider for $role..."
    candidate="${out}.fallback.$$"
    rm -f "$candidate"
    set +e
    case "$provider" in
      opencode)
        timeout "$turn_timeout" "$script_dir/ask-opencode" "$workspace" "$prompt" "$candidate"
        rc=$?
        ;;
      agy|antigravity)
        timeout "$turn_timeout" "$script_dir/ask-antigravity" "$workspace" "$prompt" "$candidate"
        rc=$?
        ;;
      *)
        echo "  fallback: unsupported provider '$provider'" >&2
        rc=2
        ;;
    esac
    set -e

    if [[ $rc -eq 0 && -s "$candidate" ]] && validate_turn_protocol "$candidate"; then
      mv "$candidate" "$out"
      echo "  fallback: $provider answered for $role"
      _last_fallback_provider="$provider"
      _last_fallback_outcome="success"
      return 0
    fi
    rm -f "$candidate"
    mark_failed "$provider"
    echo "  fallback: $provider unavailable (exit=$rc)"
  done
  if [[ "$distinct_supported_count" -eq 0 ]]; then
    _last_fallback_outcome="no_distinct_candidate"
  else
    _last_fallback_outcome="candidates_failed"
  fi
  return 1
}

# ── Gate 14B.4: el juez dentro del mismo control de integridad (RT-02) ──────
# Reuso estricto del mecanismo ya usado por los turnos de implementador y de
# revisor: ws_snapshot pre/post, ws_snapshot_ok, run_verify, y las variables
# run-scoped ws_detection_reliable / ws_delta_unverified_run que el gate de
# CONSENSUS ya evalúa. No hay un segundo sistema: solo se conecta el árbitro
# al mismo gate. El snapshot post se toma tras el intento del juez haya
# devuelto una respuesta válida, inválida o nada (siempre que haya llegado a
# ejecutarse), de modo que cualquier huella que deje en el workspace queda
# sujeta al mismo control objetivo. Como la acumulación es run-scoped, un
# tamper del juez en la ronda N impide CONSENSUS en esa y en cualquier ronda
# posterior.
judge_ws_gate() {
  local round="$1" pre="$2" post delta=0
  post="$(ws_snapshot)"
  if ws_snapshot_ok "$pre" && ws_snapshot_ok "$post"; then
    [[ "$post" != "$pre" ]] && delta=1
  else
    ws_detection_reliable=0                                          # límite de detección → fail closed
    delta=1
  fi
  if [[ "$delta" -eq 1 ]]; then
    if [[ -n "$verify_cmd" ]]; then
      run_verify "$round" "judge"
      # C-REGRESIÓN set -e: el `[[ ... ]] && asg` devolvía 1 cuando verify había
      # salido exitoso, como última sentencia de la función → aborto prematuro
      # del motor vía call_judge. `if` explícito y `return 0` garantizado.
      if [[ "$round_verify_failed" -eq 1 ]]; then
        ws_judge_verify_failed_run=1 # Gate 14B.4: persiste (round_verify_failed se resetea por ronda y el tamper puede cerrarse en ronda posterior)
      fi
    else
      ws_delta_unverified_run=1
      push_note "VERIFY REQUIRED (round $round): workspace changed during judge arbitration but AGENT_BRIDGE_VERIFY_CMD is unset; consensus will be refused without objective verification"
      echo "  workspace changed during judge arbitration; AGENT_BRIDGE_VERIFY_CMD unset (consensus will require objective verification)"
    fi
  fi
  return 0   # Gate 14B.4: el gate completo sin aborto; el control real vive en ws_* y en el gate de CONSENSUS
}

call_judge() {
  local round="$1" prompt="$run_dir/round-${round}-judge.prompt.md" out="$run_dir/round-${round}-judge.out.md"
  {
    cat "$protocol"
    echo
    echo "GOAL: $goal"
    echo "YOU ARE: third-party judge. Do NOT edit files."
    echo
    echo "# Dispute"
    cat "$handoff_file"
    echo
    echo "# Your turn"
    echo "Arbitrate. Respond with the COMPLETE protocol block above (STATUS/CHANGED/NEXT/HANDOFF; EVIDENCE optional) PLUS exactly one additional line:"
    echo "VERDICT: ACCEPT_CLAUDE | ACCEPT_CODEX | REQUEST_REVISION | BLOCKED"
    echo "Rules: exactly one VERDICT line, containing one allowed value only (no extra words, no trailing punctuation). No narration, no Markdown fences, no lines other than the protocol fields."
  } > "$prompt"

  local jrc _g14b_pre_judge
  # Gate 14B.4.4: restablecer el estado TEMPORAL del árbitro antes de cada
  # invocación; un fallo/indisponibilidad posterior jamás reutiliza el
  # veredicto de una invocación previa. La OBLIGACIÓN persistente no se toca.
  _g14b_judge_current_verdict=""
  # ── Gate 14B.4.2 (RT-01a): el árbitro debe ser independiente ───────────
  # Identidades REALES registradas por el orquestador (impl_provider /
  # review_provider), normalizadas con normalize_provider(); la exclusión es
  # round-scoped y jamás vía mark_failed (un proveedor excluido por
  # independencia no falló y sigue elegible en otras rondas/roles).
  local _g14b_impl_id _g14b_rev_id _g14b_oc_eligible=1 _g14b_agy_eligible=1
  _g14b_impl_id="$(normalize_provider "${impl_provider:-}")"
  _g14b_rev_id="$(normalize_provider "${review_provider:-}")"
  if [[ "$_g14b_impl_id" == "opencode" || "$_g14b_rev_id" == "opencode" ]]; then
    _g14b_oc_eligible=0
  fi
  if [[ "$_g14b_impl_id" == "agy" || "$_g14b_rev_id" == "agy" ]]; then
    _g14b_agy_eligible=0
  fi
  # Gate 14B.4.2 fail-closed (RT-01a-F1): NO_INDEPENDENT_JUDGE (rc=8) se usa
  # ÚNICAMENTE cuando OpenCode y AGY están excluidos POR PARTICIPACIÓN como
  # implementador o revisor de esta ronda. Si existe un candidato
  # independiente pero está marcado como fallido o no disponible, la
  # clasificación correcta es el camino JUDGE UNAVAILABLE existente: en esta
  # ronda no hay árbitro ejecutable, pero la exclusión es por fallo, no por
  # independencia. Nunca se recurre a un participante.
  if [[ "$_g14b_oc_eligible" -ne 1 && "$_g14b_agy_eligible" -ne 1 ]]; then
    push_note "NO INDEPENDENT JUDGE (round $round): every arbiter candidate already implemented or reviewed this round; refusing to continue toward possible consensus"
    echo "  independent judge unavailable: no candidate is independent of implementer '$impl_provider' and reviewer '$review_provider'"
    _g14b_judge_independence_failed=1
    return 0
  fi
  _g14b_pre_judge="$(ws_snapshot)"                                   # Gate 14B.4: estado justo antes de que el árbitro se ejecute
  rm -f "$out"
  # Primary judge: OpenCode (Gate 14B.4.2: solo si no implementó ni revisó esta ronda)
  if [[ "$_g14b_oc_eligible" -eq 1 ]] && ! is_failed opencode && ! is_failed_judge opencode; then
    echo "  escalating to OpenCode judge..."
    set +e
    timeout "$turn_timeout" "$script_dir/ask-opencode" "$workspace" "$prompt" "$out"
    jrc=$?
    set -e
    if [[ $jrc -ne 0 || ! -s "$out" ]] || ! validate_judge_protocol "$out"; then
      mark_failed_judge opencode
      rm -f "$out"
    fi
  elif [[ "$_g14b_oc_eligible" -eq 0 ]] && ! is_failed opencode; then
    echo "  judge: OpenCode excluded (independence: implemented/reviewed this round)"
  fi
  # Fallback judge: agy (Gate 14B.4.2: solo si no implementó ni revisó esta ronda)
  if [[ ! -s "$out" ]] && [[ "$_g14b_agy_eligible" -eq 1 ]] && ! is_failed agy && ! is_failed_judge agy; then
    echo "  judge: OpenCode unavailable, trying agy..."
    rm -f "$out"
    set +e
    timeout "$turn_timeout" "$script_dir/ask-antigravity" "$workspace" "$prompt" "$out"
    jrc=$?
    set -e
    if [[ $jrc -ne 0 || ! -s "$out" ]] || ! validate_judge_protocol "$out"; then
      mark_failed_judge agy
      rm -f "$out"
    fi
  elif [[ ! -s "$out" ]] && [[ "$_g14b_agy_eligible" -eq 0 ]] && ! is_failed agy; then
    echo "  judge: agy excluded (independence: implemented/reviewed this round)"
  fi
  if [[ ! -s "$out" ]]; then
    push_note "JUDGE UNAVAILABLE (round $round): all judge providers unavailable; operator review advised"
    judge_ws_gate "$round" "$_g14b_pre_judge"                        # Gate 14B.4: detecta tamper aunque la respuesta fuese inválida o vacía
    return 0
  fi
  push_note "JUDGE VERDICT (round $round): $(judge_summary "$out")"
  # Gate 14B.4.4: registro del ÚNICO veredicto vigente (campo validado y
  # anclado; la respuesta ya pasó validate_judge_protocol).
  _g14b_judge_current_verdict="$(judge_verdict "$out")"
  judge_ws_gate "$round" "$_g14b_pre_judge"                          # Gate 14B.4: delta del juez → mismo control que implementador/revisor
}

# ── Gate 14B.4.4 (RT-03): la decisión arbitral gobierna las transiciones ────
# Procesa el veredicto VALIDADO por call_judge (solo judge_verdict(); jamás
# texto del handoff, stdout de agentes o comentarios). Las rondas posteriores
# ya no ignoran BLOCKED/REQUEST_REVISION/ACCEPT_CODEX/ACCEPT_CLAUDE.
# BLOCKED: termina en la misma ronda (rc=3), salvo fallo de integridad del
# workspace, en cuyo caso prevalece VERIFY_FAILING (rc=2) — una decisión
# arbitral nunca neutraliza una condición de integridad fallida.
# REQUEST_REVISION/ACCEPT_CODEX: obligación persistente con ronda de origen.
# ACCEPT_CLAUDE: la objeción del revisor queda retirada POR el arbitraje; no
# hay obligación, y el consenso posterior exige la revisión independiente
# post-arbitraje más los controles de seguridad del workspace existentes.
process_judge_verdict() {
  local round="$1"
  echo "  judge verdict processed (round $round): $_g14b_judge_current_verdict"
  case "$_g14b_judge_current_verdict" in
    REQUEST_REVISION|ACCEPT_CODEX)
      # Conservación determinista: un arbitraje sucesivo nunca borra ni
      # reinicia una obligación pendiente. Se conserva el origen (veredicto y
      # ronda); solo avanza la ronda del último arbitraje, desde la cual debe
      # acreditarse la entrega.
      if [[ -n "$_g14b_judge_obligation" ]]; then
        echo "  judge obligation preserved (origin: $_g14b_judge_obligation, round $_g14b_judge_obligation_round); superseding arbitration $_g14b_judge_current_verdict at round $round (Round $round - Reviewer ($review_provider))"
      else
        _g14b_judge_obligation="$_g14b_judge_current_verdict"
        _g14b_judge_obligation_round="$round"
      fi
      _g14b_judge_obligation_last_round="$round"
      # Sin push_note: las notas añadidas desplazan la ventana de
      # trim_handoff y recortarían notas que los casos RT-02/RT-01a aserten.
      # El registro vinculante aquí es el estado interno + este echo.
      ;;
    ACCEPT_CLAUDE)
      # La objeción del revisor queda retirada POR el arbitraje; sin
      # obligación. El consenso posterior exige la revisión independiente
      # post-arbitraje más los controles de seguridad del workspace.
      # Una obligación previa pendiente NO se borra aquí (solo la libera una
      # entrega acreditada posterior).
      ;;
    BLOCKED)
      if [[ "$round_verify_failed" -eq 1 || "$ws_judge_verify_failed_run" -eq 1 || "$ws_delta_unverified_run" -eq 1 || "$ws_detection_reliable" -eq 0 ]]; then
        echo "  arbiter verdict BLOCKED overridden by failing workspace integrity"
        final_state="VERIFY_FAILING"
      else
        final_state="BLOCKED"
      fi
      ;;
  esac
  return 0
}

changed_something() {
  local changed
  changed="$(get_field "$1" CHANGED | tr '[:upper:]' '[:lower:]')"
  [[ -n "$changed" && "$changed" != "none" && "$changed" != '"none"' ]]
}

echo "Run: $run_dir"

final_state="MAX_ROUNDS"
claude_status=""
codex_status=""
ws_delta_unverified_run=0   # Gate 14B: hubo cambios reales sin ground truth ejecutable
ws_detection_reliable=1     # Gate 14B: detección de delta garantizable; 0 = límite detectado → fail closed
ws_judge_verify_failed_run=0 # Gate 14B.4: ground truth falló tras delta del juez; run-scoped porque round_verify_failed es por ronda
_g14b_judge_independence_failed=0 # Gate 14B.4.2: sin árbitro independiente esta ronda → NO_INDEPENDENT_JUDGE, se reinicia en cada invocación del juez
# ── Gate 14B.4.4 (RT-03): estado vinculante del árbitro ────────────────────
# _g14b_judge_current_verdict: el veredicto VALIDADO de la invocación del
# árbitro en curso, leído EXCLUSIVAMENTE del campo anclado por judge_verdict()
# (nunca del handoff, del stdout de agentes ni de comentarios). Se restablece
# al inicio de cada call_judge: si el árbitro falla o queda indisponible no se
# reutiliza un veredicto anterior.
# _g14b_judge_obligation / _round (origen) / _last_round (último arbitraje): obligación persistente
# (REQUEST_REVISION u ACCEPT_CODEX) con ronda de origen; los arbitrajes
# sucesivos la conservan (nunca la reemplazan). Vive en el estado del motor, NO en el handoff recortable; la
# genera un veredicto válido activo y la cierra el proceso de resolución
# del consenso; un arbitraje posterior la conserva (solo avanza _last_round).
_g14b_judge_current_verdict=""
_g14b_judge_obligation=""
_g14b_judge_obligation_round=""
_g14b_judge_obligation_last_round=""

for ((round=1; round<=rounds; round++)); do
  round_verify_failed=0
  impl_provider=""
  review_provider=""

  printf '\n=== Round %d: Claude ===\n' "$round"
  c_prompt="$run_dir/round-${round}-claude.prompt.md"
  c_out="$run_dir/round-${round}-claude.out.md"
  build_prompt "$c_prompt" "implementer/planner" "" \
    "Make concrete progress toward the goal, or revise per the latest feedback/verdict." \
    "Modify the workspace only if needed."
  _g14b_pre_impl="$(ws_snapshot)"
  if ! call_claude "$c_prompt" "$c_out"; then
    _g14b_impl_rejected="unavailable"
  elif ! validate_turn_protocol "$c_out"; then                       # Gate 14B / P0-2
    push_handoff "Round $round - Implementer (claude, protocol-invalid)" "$c_out"
    push_note "ORCHESTRATOR REJECTED (round $round): primary implementer 'claude' returned a protocol-invalid response; independent fallback required"
    echo "  claude returned a protocol-invalid response; starting automatic fallback"
    _g14b_impl_rejected="invalid"
  else
    _g14b_impl_rejected=""
  fi
  if [[ -n "$_g14b_impl_rejected" ]]; then
    echo "  claude ${_g14b_impl_rejected}; starting automatic fallback"
    if ! call_fallback "implementer" "$c_prompt" "$c_out" ""; then
      [[ -s "$c_out" ]] || synth_block "$c_out" "Claude and configured fallback providers failed"
      push_handoff "Round $round - Implementer (${_g14b_impl_rejected})" "$c_out"
      final_state="CLAUDE_ERROR"
      break
    fi
    impl_provider="$_last_fallback_provider"
  else
    impl_provider="claude"
  fi
  push_handoff "Round $round - Implementer ($impl_provider)" "$c_out"
  claude_status="$(get_status "$c_out")"
  echo "  claude STATUS: ${claude_status:-?}"
  _g14b_post_impl="$(ws_snapshot)"
  _g14b_impl_delta=0
  if ws_snapshot_ok "$_g14b_pre_impl" && ws_snapshot_ok "$_g14b_post_impl"; then
    [[ "$_g14b_post_impl" != "$_g14b_pre_impl" ]] && _g14b_impl_delta=1
  else
    ws_detection_reliable=0                                          # límite de detección → fail closed
    _g14b_impl_delta=1
  fi
  if [[ "$_g14b_impl_delta" -eq 1 ]]; then
    if [[ -n "$verify_cmd" ]]; then
      run_verify "$round" "$impl_provider"
    else
      ws_delta_unverified_run=1
      push_note "VERIFY REQUIRED (round $round): workspace changed during implementer turn but AGENT_BRIDGE_VERIFY_CMD is unset; consensus will be refused without objective verification"
      echo "  workspace changed; AGENT_BRIDGE_VERIFY_CMD unset (consensus will require objective verification)"
    fi
  elif [[ -n "$verify_cmd" ]] && changed_something "$c_out"; then
    run_verify "$round" "$impl_provider"
  fi

  printf '\n=== Round %d: Codex ===\n' "$round"
  x_prompt="$run_dir/round-${round}-codex.prompt.md"
  x_out="$run_dir/round-${round}-codex.out.md"
  verify_hint="Independently verify the latest implementer's claim. Respond VERIFIED only if you checked it yourself."
  [[ "$claude_status" == "COMPLETE" ]] && verify_hint="The latest implementer claims COMPLETE. Verify independently; respond VERIFIED or DISAGREE with evidence."
  build_prompt "$x_prompt" "reviewer/verifier" "LATEST IMPLEMENTER PROVIDER: $impl_provider" "$verify_hint"
  _g14b_pre_rev="$(ws_snapshot)"
  _g14b_rev_fallback=0
  if ! call_codex "$x_prompt" "$x_out"; then
    echo "  codex unavailable; starting automatic fallback"
    _g14b_rev_fallback=1
  elif ! validate_turn_protocol "$x_out"; then                        # Gate 14B / P0-2
    push_handoff "Round $round - Reviewer (codex, protocol-invalid)" "$x_out"
    push_note "ORCHESTRATOR REJECTED (round $round): primary reviewer 'codex' returned a protocol-invalid response; an independent fallback reviewer is required"
    echo "  codex returned a protocol-invalid response; starting automatic fallback"
    _g14b_rev_fallback=1
  fi
  if [[ "$_g14b_rev_fallback" -eq 1 ]]; then
    if ! call_fallback "reviewer" "$x_prompt" "$x_out" "$impl_provider"; then
      case "${_last_fallback_outcome:-}" in
        no_distinct_candidate)
          synth_block "$x_out" "independent reviewer unavailable: no distinct supported fallback reviewer is configured"
          push_handoff "Round $round - Reviewer (unavailable)" "$x_out"
          push_note "INDEPENDENT REVIEW UNAVAILABLE (round $round): no distinct supported fallback reviewer is configured after excluding implementer provider '$impl_provider'; refusing to emit consensus"
          echo "  independent reviewer unavailable: no distinct supported fallback reviewer is configured"
          final_state="NO_INDEPENDENT_REVIEWER"
          break
          ;;
        candidates_failed)
          synth_block "$x_out" "independent reviewer failed: distinct supported fallback reviewer candidates existed but all were unavailable or failed"
          push_handoff "Round $round - Reviewer (failed)" "$x_out"
          push_note "INDEPENDENT REVIEW FAILED (round $round): distinct supported fallback reviewer candidates existed but all were unavailable or failed; refusing to emit consensus"
          echo "  independent reviewer failed: distinct supported fallback reviewer candidates existed but all were unavailable or failed"
          final_state="CODEX_ERROR"
          break
          ;;
        *)
          synth_block "$x_out" "internal fallback classification failure while selecting independent reviewer"
          push_handoff "Round $round - Reviewer (classification failure)" "$x_out"
          push_note "INTERNAL FALLBACK CLASSIFICATION FAILURE (round $round): reviewer fallback outcome '${_last_fallback_outcome:-unset}' was not recognized; refusing to emit consensus"
          echo "  independent reviewer failed: internal fallback classification failure"
          final_state="CODEX_ERROR"
          break
          ;;
      esac
    fi
    review_provider="$_last_fallback_provider"
  else
    review_provider="codex"
  fi
  push_handoff "Round $round - Reviewer ($review_provider)" "$x_out"
  codex_status="$(get_status "$x_out")"
  echo "  codex STATUS: ${codex_status:-?}"
  _g14b_post_rev="$(ws_snapshot)"
  _g14b_rev_delta=0
  if ws_snapshot_ok "$_g14b_pre_rev" && ws_snapshot_ok "$_g14b_post_rev"; then
    [[ "$_g14b_post_rev" != "$_g14b_pre_rev" ]] && _g14b_rev_delta=1
  else
    ws_detection_reliable=0                                           # límite de detección → fail closed
    _g14b_rev_delta=1
  fi
  if [[ "$_g14b_rev_delta" -eq 1 ]]; then
    if [[ -n "$verify_cmd" ]]; then
      run_verify "$round" "$review_provider"
    else
      ws_delta_unverified_run=1
      push_note "VERIFY REQUIRED (round $round): workspace changed during reviewer turn but AGENT_BRIDGE_VERIFY_CMD is unset; consensus will be refused without objective verification"
      echo "  workspace changed; AGENT_BRIDGE_VERIFY_CMD unset (consensus will require objective verification)"
    fi
  elif [[ -n "$verify_cmd" ]] && changed_something "$x_out"; then
    run_verify "$round" "$review_provider"
  fi

  # Defense in depth: even if selection logic above is ever bypassed, never
  # accept a reviewer identity that matches the implementer identity for
  # this round. Independence is decided by provider identity alone.
  if [[ -n "$review_provider" && -n "$impl_provider" && "$review_provider" == "$impl_provider" ]]; then
    push_note "ORCHESTRATOR REJECTED (round $round): reviewer provider '$review_provider' is the same identity that implemented this round; independent review unavailable"
    echo "  independent reviewer unavailable: provider '$review_provider' cannot review its own implementation"
    final_state="NO_INDEPENDENT_REVIEWER"
    break
  fi

  case "$codex_status" in
    VERIFIED|COMPLETE)
      if [[ "$round_verify_failed" -eq 1 ]]; then
        push_note "ORCHESTRATOR REJECTED $codex_status (round $round): ground truth command is failing; fix it before closing"
        echo "  consensus REJECTED: verify failing"
        final_state="VERIFY_FAILING"
      elif [[ "$ws_judge_verify_failed_run" -eq 1 ]]; then         # Gate 14B.4: verify falló tras delta del juez en una ronda previa
        push_note "ORCHESTRATOR REJECTED $codex_status (round $round): ground truth failed after workspace change during judge arbitration; fix it before closing"
        echo "  consensus REJECTED: ground truth failing after judge arbitration"
        final_state="VERIFY_FAILING"
      elif [[ "$ws_detection_reliable" -eq 0 ]]; then                # Gate 14B.3: UNRELIABLE bloquea CONSENSUS incluso con verify exitoso
        push_note "ORCHESTRATOR REJECTED $codex_status (round $round): workspace snapshot unreliable (detection limit); an exit=0 of verify does not restore the lost confidence"
        echo "  consensus REJECTED: workspace snapshot unreliable (detection limit)"
        final_state="VERIFY_FAILING"
      elif [[ "$ws_delta_unverified_run" -eq 1 ]]; then               # Gate 14B / P0-3: fail closed
        push_note "ORCHESTRATOR REJECTED $codex_status (round $round): workspace changed without objective ground-truth verification (AGENT_BRIDGE_VERIFY_CMD unset${ws_detection_reliable:+; detection limit invoked})"
        echo "  consensus REJECTED: workspace changed without objective verification"
        final_state="VERIFY_FAILING"
      elif [[ -n "$_g14b_judge_obligation" ]]; then                   # Gate 14B.4.4: obligación del árbitro fail-closed
        # Un VERIFIED/COMPLETE del revisor solo cierra el consenso si el
        # implementador acredita la entrega (ver regla siguiente).
        # Liberación (F2/F3): ni la identidad distinta del revisor ni un STATUS
        # declarado liberan por sí solos. Exige, tras el ÚLTIMO arbitraje, una
        # entrega acreditada del implementador: cierre declarado
        # (COMPLETE/VERIFIED) o delta objetivo del workspace (que ya superó la
        # verificación de ground truth arriba), Y la revisión independiente
        # de esta ronda (VERIFIED/COMPLETE, evaluada por el case). PROPOSED u
        # otro estado sin delta, o el eco DISAGREE/REVISE, no liberan.
        _g14b_obligation_released=0
        if [[ "$_g14b_judge_obligation_last_round" =~ ^[0-9]+$ && "$round" -gt "$_g14b_judge_obligation_last_round" ]]; then   # estado no numérico → fail-closed
          if [[ "$claude_status" == "COMPLETE" || "$claude_status" == "VERIFIED" ]]; then
            _g14b_obligation_released=1
          elif [[ "$_g14b_impl_delta" -eq 1 && "$claude_status" != "DISAGREE" && "$claude_status" != "REVISE" && "$claude_status" != "BLOCKED" ]]; then
            _g14b_obligation_released=1
          fi
        fi
        if [[ "$_g14b_obligation_released" -eq 1 ]]; then
          echo "  judge obligation released (VERDICT: $_g14b_judge_obligation, round $_g14b_judge_obligation_round)"
          _g14b_judge_obligation=""
          _g14b_judge_obligation_round=""
          _g14b_judge_obligation_last_round=""
          final_state="CONSENSUS"
          break
        else
          echo "  consensus REJECTED: unresolved judge obligation (VERDICT: $_g14b_judge_obligation, round $_g14b_judge_obligation_round)"
          # Sin break: una ronda posterior puede acreditar la resolución.
        fi
      else
        final_state="CONSENSUS"
        break
      fi
      ;;
    BLOCKED)
      final_state="BLOCKED"
      break
      ;;
    DISAGREE)
      if [[ "$claude_status" == "DISAGREE" || "$claude_status" == "REVISE" ]]; then
        _g14b_judge_independence_failed=0
        call_judge "$round"
        # Gate 14B.4.2: sin árbitro independiente no se continúa silenciosamente
        # hacia un posible consenso posterior; corte explícito de la ronda.
        if [[ "$_g14b_judge_independence_failed" -eq 1 ]]; then
          final_state="NO_INDEPENDENT_JUDGE"
          break
        fi
        # Gate 14B.4.4 (RT-03): con árbitro independiente, su veredicto
        # VALIDADO gobierna la transición (nunca texto del handoff/stdout).
        if [[ -n "$_g14b_judge_current_verdict" ]]; then
          process_judge_verdict "$round"
          if [[ "$_g14b_judge_current_verdict" == "BLOCKED" ]]; then
            break
          fi
        fi
      fi
      ;;
  esac
done

echo
echo "=== Done: $final_state ==="
[[ "$resume_claude" == "1" ]] && echo "Total Claude cost: \$${total_cost}"
echo "Artifacts: $run_dir"
echo "Final handoff state:"
cat "$handoff_file"

# ── Gate 14B / P0-1: códigos de salida documentados (README) ─────────────────
# 0 CONSENSUS · 1 MAX_ROUNDS/esperado no mapeado · 2 VERIFY_FAILING
# 3 BLOCKED · 4 CLAUDE_ERROR · 5 CODEX_ERROR · 6 NO_INDEPENDENT_REVIEWER
# 8 NO_INDEPENDENT_JUDGE (Gate 14B.4.2: sin árbitro independiente de impl+rev)
# 2 de invocación: args inválidos · 7 workspace no autorizado por allowlist
case "$final_state" in
  CONSENSUS) exit 0 ;;
  MAX_ROUNDS) exit 1 ;;
  VERIFY_FAILING) exit 2 ;;
  BLOCKED) exit 3 ;;
  CLAUDE_ERROR) exit 4 ;;
  CODEX_ERROR) exit 5 ;;
  NO_INDEPENDENT_REVIEWER) exit 6 ;;
  NO_INDEPENDENT_JUDGE) exit 8 ;;
  *) exit 1 ;;
esac
