#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 2 ]]; then
  echo "Usage: ask-claude <workspace> <prompt-file> [output-file]" >&2
  exit 2
fi

workspace="$1"
prompt_file="$2"
output_file="${3:-}"

[[ -d "$workspace" ]] || { echo "Workspace not found: $workspace" >&2; exit 2; }
[[ -f "$prompt_file" ]] || { echo "Prompt file not found: $prompt_file" >&2; exit 2; }

cd "$workspace"

# AGENT_BRIDGE_CLAUDE_READONLY=1: planner/auditor mode (no edits), as used by agent-turns roles v2.
mode=(--permission-mode acceptEdits)
if [[ "${AGENT_BRIDGE_CLAUDE_READONLY:-0}" == "1" ]]; then
  mode=(--permission-mode plan --disallowed-tools "Edit,Write,NotebookEdit")
fi

if [[ -n "$output_file" ]]; then
  claude -p "${mode[@]}" --output-format text --add-dir "$workspace" - < "$prompt_file" > "$output_file"
else
  claude -p "${mode[@]}" --output-format text --add-dir "$workspace" - < "$prompt_file"
fi
